---
import type { Source } from '../lib/domain';
import { EVALUATOR_DESCRIPTIONS, EVALUATOR_LABELS, rubricLabel } from '../lib/labels';

interface Props {
  source: Source;
  revision?: number | null;
  size?: 'small' | 'regular';
}

const { source, revision = null, size = 'regular' } = Astro.props as Props;
---
<span class:list={['evaluator', `evaluator-${source}`, size === 'small' && 'evaluator-small']} title={EVALUATOR_DESCRIPTIONS[source]}>
  <span class="evaluator-glyph" aria-hidden="true">{source === 'human' ? '⚇' : '⌬'}</span>
  <span>{EVALUATOR_LABELS[source]}</span>
  {revision && <span class="evaluator-revision">{rubricLabel(revision)}</span>}
</span>
