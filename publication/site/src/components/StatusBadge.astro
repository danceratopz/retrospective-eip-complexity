---
/**
 * Shared assessment-status badge. Zero complexity, unavailable, incomplete, and not-applicable states
 * always look different from each other and from a scored tier.
 */
import type { Mode, Status } from '../lib/domain';
import { STATUS_DESCRIPTIONS, statusLabel } from '../lib/labels';

interface Props {
  status: Status;
  mode?: Mode;
  detail?: string | null;
  size?: 'small' | 'regular';
  /** When given, the badge is a link to the report or source that backs the status. */
  href?: string | null;
}

const { status, mode = 'retrospective', detail = null, size = 'regular', href = null } = Astro.props as Props;
const Tag = href ? 'a' : 'span';
const glyphs: Record<Status, string> = {
  complete: '●',
  available_in_open_pr: '◐',
  in_progress: '◔',
  incomplete: '◌',
  not_applicable: '⊘',
  not_available: '○',
};
---
<Tag class:list={['status', `status-${status}`, size === 'small' && 'status-small', href && 'status-link']} title={detail ?? STATUS_DESCRIPTIONS[status]} href={href ?? undefined}>
  <span class="status-glyph" aria-hidden="true">{glyphs[status]}</span>
  <span>{statusLabel(status, mode)}</span>
</Tag>
