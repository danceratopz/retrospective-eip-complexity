---
/**
 * Stacked criterion bar: one segment per non-zero criterion, proportional to its score.
 *
 * `max` fixes the scale so bars in the same table are comparable (absolute mode); `normalized` stretches
 * every bar to the full width (composition mode). The whole bar is one keyboard stop whose tooltip and
 * accessible name read out every segment; individual segments answer pointer hover. Markup comes from
 * the shared renderer in `lib/stacked-bar.ts`, which the client-side comparison view also uses.
 */
import type { CriterionDefinition } from '../lib/domain';
import { stackedBarHtml, type BarSegment } from '../lib/stacked-bar';

interface Props {
  segments: BarSegment[];
  definitions: Record<string, CriterionDefinition | string> | Map<string, CriterionDefinition | string>;
  total?: number;
  max?: number;
  normalized?: boolean;
  size?: 'compact' | 'regular' | 'large';
  label: string;
  unit?: string;
  showTotal?: boolean;
  class?: string;
}

const { segments, definitions, total, max, normalized = false, size = 'regular', label, unit = 'points', showTotal = false, class: className } = Astro.props as Props;
const labels = new Map<string, string>();
for (const [id, definition] of definitions instanceof Map ? definitions.entries() : Object.entries(definitions)) labels.set(id, typeof definition === 'string' ? definition : definition.label);
const html = stackedBarHtml({ segments, labels, total, max, normalized, size, label, unit, showTotal, className });
---
<Fragment set:html={html} />
