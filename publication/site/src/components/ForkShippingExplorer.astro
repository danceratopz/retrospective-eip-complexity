---
/**
 * Fork shipping time against initial-scope complexity, with a least-squares fit and nested 50/80/95% prediction bands, an
 * and a Hegotá scope builder whose total is drawn as a position on the complexity axis.
 *
 * Only the primary evaluation is shown; other evaluations use different checklist revisions and are not comparable.
 * All view state is in the URL: `lists` (EIP-8081 lists),
 * `add` and `drop` (per-EIP overrides), and `ai` (the exploratory AI-capability scaling α; absent means off). Without JavaScript the semantic tables below carry the same values.
 */
import type { Publication } from '../lib/domain';
import { stackedBarHtml } from '../lib/stacked-bar';

interface Props {
  data: Publication;
}

const { data } = Astro.props as Props;
const shipping = data.fork_shipping;
const builder = data.hegota_builder;
const primary = data.primary_evaluation;
const evaluation = { key: primary, ...(shipping.evaluations as Record<string, any>)[primary] };
const labels: Record<string, string> = Object.fromEntries(data.criteria.map((item) => [item.id, item.label]));
const DEFAULT_LISTS = ['SFI', 'CFI'];
const scored = builder.entries.filter((item: any) => item.status === 'scored');
const inLists = (lists: string[]) => scored.filter((item: any) => lists.includes(item.list));
const total = (items: any[]) => items.reduce((sum: number, item: any) => sum + item.score, 0);
const profile = (items: any[]) => {
  const sums = new Map<string, number>();
  for (const item of items) for (const criterion of item.criteria) sums.set(criterion.id, (sums.get(criterion.id) ?? 0) + criterion.score);
  return [...sums].map(([id, score]) => ({ id, score }));
};
const initial = inLists(DEFAULT_LISTS);
const initialBar = stackedBarHtml({ segments: profile(initial), labels, total: total(initial), size: 'large', label: 'Hegotá scenario EL-rubric complexity', showTotal: true });
const payload = {
  primary,
  x_max: shipping.x_max,
  evaluation: { label: evaluation.label, rows: evaluation.rows, fit: evaluation.fit },
  builder: { lists: builder.lists, list_labels: builder.list_labels, entries: builder.entries, default_lists: DEFAULT_LISTS },
  labels,
  ai: shipping.ai_capability,
};
const ai = {
  metric_url: 'https://metr.org/blog/2026-1-29-time-horizon-1-1/',
  paper_url: 'https://arxiv.org/abs/2503.14499',
  ...shipping.ai_capability,
};
const primaryRows = shipping.rows as any[];
const referenceRows = primaryRows.filter((row) => row.ai_horizon_minutes === ai.reference_horizon_minutes);
const referenceNames = referenceRows.map((row) => row.fork_short).join(' and ');
const referenceDetails = referenceRows.map((row) => `${row.fork_short}’s first two-client devnet launched on ${row.first_multi_el_devnet_at}`).join('; ') + '.';
const scenarios = Object.entries(builder.scenarios) as [string, any][];
const listCount = (list: string) => builder.entries.filter((item: any) => item.list === list).length;
const listScored = (list: string) => scored.filter((item: any) => item.list === list);
---
<section class="shipping-explorer" data-shipping-explorer aria-labelledby="shipping-explorer-heading">
  <script type="application/json" data-shipping-payload set:html={JSON.stringify(payload)}></script>
  <h2 id="shipping-explorer-heading">Fork Shipping Time Versus Predicted Complexity, With Hegotá</h2>
  <div class="caveat"><strong>Very uncertain: five forks, and the Hegotá scope is still changing.</strong> The line is a least-squares fit over five points, one of them projected (Amsterdam). The nested shaded bands are its central 50%, 80% and 95% prediction intervals for one new fork, the innermost most strongly shaded; they assume the straight-line model is right, which five points cannot confirm. Hegotá is shown only as a position on the complexity axis. Read where it lands against earlier forks, not a ship date.</div>

  <div class="explorer-controls">
    <fieldset class="hegota-lists">
      <legend>Hegotá scope from EIP-8081{builder.lists_as_of.label !== 'Task 10 snapshot' ? ` after ${builder.lists_as_of.label}` : ''}</legend>
      <p class="muted">Lists as of EIPs <a href={`https://github.com/ethereum/EIPs/blob/${builder.lists_as_of.commit}/EIPS/eip-8081.md`}><code>{builder.lists_as_of.commit.slice(0, 7)}</code></a> ({builder.lists_as_of.committed_at.slice(0, 10)}); scores from the Opus 5.5 · v3 assessment of each EIP at <code>{builder.eips_commit.slice(0, 7)}</code>. EIPs added since are listed as not yet assessed and never count as zero.</p>
      <div class="chip-row">
        {builder.lists.map((list: string) => (
          <button type="button" class="chip" data-hegota-list={list} aria-pressed={DEFAULT_LISTS.includes(list) ? 'true' : 'false'} title={builder.list_labels[list]}>
            {list} <span class="chip-meta">{listCount(list)} EIPs · {total(listScored(list))} pts</span>
          </button>
        ))}
      </div>
      <p class="hegota-readout" aria-live="polite" data-hegota-readout>EL-rubric total {total(initial)} across {initial.length} scored EIPs</p>
      <div data-hegota-profile set:html={initialBar} />
      <details class="hegota-eips">
        <summary>Choose individual EIPs</summary>
        {builder.lists.map((list: string) => (
          <fieldset class="hegota-eip-group">
            <legend>{list}: {builder.list_labels[list]}</legend>
            {builder.entries.filter((item: any) => item.list === list).map((item: any) => (
              <label class:list={['hegota-eip', item.status !== 'scored' && 'is-na']}>
                <input type="checkbox" data-hegota-eip={item.eip} data-list={item.list} checked={item.status === 'scored' && DEFAULT_LISTS.includes(item.list)} disabled={item.status !== 'scored'} />
                <span>EIP-{item.eip} {item.title}</span>
                <span class="muted">{item.status === 'scored' ? `${item.score} · ${item.tier}` : item.status === 'not_assessed' ? `Added at ${builder.lists_as_of.label}; not yet assessed` : 'Not applicable to EL rubric'}{item.disposition_review === 'proposed_pending_owner_review' ? ' · provisional disposition' : ''}</span>
              </label>
            ))}
          </fieldset>
        ))}
      </details>
      <p><button type="button" class="button-secondary" data-copy-scenario>Copy link to this view</button> <span class="muted" data-copy-status aria-live="polite"></span></p>
    </fieldset>

    <details class="ai-scaling" data-ai-panel>
      <summary>Exploratory: scale complexity by frontier AI capability</summary>
      <div class="ai-body">
        <label><input type="checkbox" data-ai-toggle /> Divide each fork’s complexity by 1 + α · log₂(H ÷ H₀)</label>
        <label class="ai-alpha">α, share of effort saved per doubling of AI capability <input type="range" min="0.01" max="0.3" step="0.01" value="0.1" data-ai-alpha disabled /> <output data-ai-alpha-value>0.10</output></label>
        <details class="ai-more">
          <summary>More info</summary>
          <div class="ai-info">
            <p><strong>In short:</strong> each fork’s complexity is divided by a factor that grows with the AI coding capability available when its client development began. {referenceNames} are the reference, so the slider never moves them; later forks shrink as α grows. AI can speed up only part of the work: coordinating Ethereum’s independent client teams sets a floor. This view is off by default, display-only, and never a study result.</p>
            <h4>What H measures</h4>
            <p>H is <a href={ai.metric_url}>METR’s 50% task-completion time horizon</a>: the length of software task, in human working minutes, that a model completes with 50% success on METR’s task suite. For each fork, H is the horizon of the best model released on or before the fork’s first devnet with at least two independent execution-layer clients, the point where implementation work begins in earnest. The values come from METR’s <a href={ai.source_url}>published results file</a>, retrieved {ai.retrieved_at.slice(0, 10)}; the <a href="#ai-capability-table">table below the chart</a> lists the model and horizon used for every fork.</p>
            <h4>Why {referenceNames} do not move</h4>
            <p>H₀ is the horizon at the earliest fork’s devnet, {ai.reference_horizon_minutes} min, and every fork at that level has H ÷ H₀ = 1, so log₂(1) = 0 and its divisor is 1 for any α. {referenceDetails} METR measured gpt-3.5-turbo-instruct (released March 2022) and next GPT-4 (released 14 March 2023), with nothing in between; ChatGPT, released on 30 November 2022, has no METR score. Both devnets fall in that gap, so both get the same model and the same horizon. Cancun’s tie is partly an artefact of that gap: most of its 415-day implementation window came after GPT-4.</p>
            <h4>What α means</h4>
            <p>α is the share of testing and implementation effort assumed to be saved for every doubling of the horizon. It is chosen by the reader, not estimated: five forks cannot separate it from everything else that changed between them. The fit line and its 50/80/95% bands are recomputed on the scaled values for display. Hegotá has no devnet yet, so it uses the latest measured model ({ai.hegota.model}, {ai.hegota.horizon_minutes} min); its eventual horizon will be at least that, so its scaled total is an upper bound.</p>
            <h4>Why AI help has a floor</h4>
            <p>Much of a fork’s implementation burden is human coordination rather than code. Ethereum deliberately runs several independent client implementations, so that a bug in any one of them cannot take down the network; client diversity is a security property, not an inefficiency. Its cost is that every fork is implemented separately by each client team, and the teams must agree on every observable behaviour, including edge cases. That agreement comes through specification work, shared test suites, multi-client devnets and coordination calls.</p>
            <p>AI can shorten the work inside each team: reading the specification, writing code and tests, and finding bugs. It does much less for the coordination between teams, which moves at the pace of people reaching agreement and of devnets that have to run before a fork ships. That work sets a floor under how much AI can help protocol developers take on more complex forks. Dividing a fork’s whole complexity by one factor, as this view does, therefore overstates the effect; read α as applying only to the share of the work AI can actually accelerate.</p>
            <h4>Limitations</h4>
            <p>The horizon is measured on METR’s tasks, not Ethereum client work; the newest model is not necessarily the one client teams used; and teams adopted AI tools with a lag the measure ignores. Treat the view as a what-if, not an adjustment the study endorses.</p>
            <p class="muted">Sources: <a href={ai.metric_url}>METR, Time Horizon 1.1</a> · <a href={ai.paper_url}>METR, Measuring AI Ability to Complete Long Tasks</a> · <a href={ai.source_url}>METR results file</a></p>
          </div>
        </details>
      </div>
    </details>
  </div>

  <figure class="chart-figure">
    <div class="chart" data-shipping-chart role="img" aria-label="Fork shipping span against the complexity of each fork’s initial scope, with a least-squares fit, its nested 50%, 80% and 95% prediction bands and the selected Hegotá scenario total">
      <p class="chart-status">Loading interactive chart…</p>
    </div>
    <p class="band-legend" aria-hidden="true"><span class="band-swatch band-50"></span>50% <span class="band-swatch band-80"></span>80% <span class="band-swatch band-95"></span>95% prediction interval <span class="fit-swatch"></span>least-squares fit <span class="hegota-swatch"></span>Hegotá scenario</p>
    <figcaption class="muted" data-shipping-caption>Calendar days from each fork’s first devnet with at least two independent EL clients to mainnet, against the complexity score sum of its initial scope: the EIPs in scope at the fork’s last initial scope-setting decision before its main implementation cycle (Task 04b, provisional). EIPs added later are excluded. Open point: Amsterdam, projected mainnet 15 December 2026. Shaded bands: central 50% (strongest shading), 80% and 95% prediction intervals around the dashed least-squares line. With the exploratory AI-capability scaling on, each fork’s complexity is divided by its scaling factor and the line and bands are refitted on the scaled values.</figcaption>
  </figure>

  <div class="table-region" role="region" aria-label="Fit summary" tabindex="0">
    <table>
      <caption>Least-squares fit over the five forks ({evaluation.label})</caption>
      <thead><tr><th scope="col">Evaluation</th><th scope="col" class="number">Days per point</th><th scope="col" class="number">Intercept (days)</th><th scope="col" class="number">Residual SE (days)</th><th scope="col" class="number">R²</th></tr></thead>
      <tbody>{[evaluation].map((item) => <tr><td>{item.label}</td><td class="number">{item.fit.slope_days_per_point}</td><td class="number">{item.fit.intercept_days}</td><td class="number">{item.fit.residual_standard_error_days}</td><td class="number">{item.fit.r_squared}</td></tr>)}</tbody>
    </table>
  </div>
  <div class="table-region" role="region" aria-label="Hegotá scenarios" tabindex="0">
    <table>
      <caption>Hegotá EL-rubric totals by EIP-8081 list as of {builder.lists_as_of.label} (Opus 5.5 · v3)</caption>
      <thead><tr><th scope="col">Scenario</th><th scope="col" class="number">Scored EIPs</th><th scope="col" class="number">Not applicable</th><th scope="col" class="number">Not yet assessed</th><th scope="col" class="number">EL-rubric total</th></tr></thead>
      <tbody>{scenarios.map(([name, item]) => <tr><td>{name}</td><td class="number">{item.scored_eips}</td><td class="number">{item.not_applicable_eips}</td><td class="number">{item.not_assessed_eips}</td><td class="number">{item.score_sum}</td></tr>)}</tbody>
    </table>
  </div>
  <div class="table-region" id="ai-capability-table" role="region" aria-label="AI capability by fork" tabindex="0">
    <table>
      <caption>Frontier AI capability at each fork’s first ≥2-client devnet: METR’s 50% time horizon, <a href={ai.metric_url}>measured by METR (Time Horizon 1.1)</a>, values from METR’s <a href={ai.source_url}>published results file</a> retrieved {ai.retrieved_at.slice(0, 10)}</caption>
      <thead><tr><th scope="col">Fork</th><th scope="col">First ≥2-EL devnet</th><th scope="col">Frontier model then</th><th scope="col" class="number">50% horizon, min [METR CI]</th><th scope="col">METR measurement</th></tr></thead>
      <tbody>
        {primaryRows.map((row) => <tr><td>{row.fork_name}</td><td>{row.first_multi_el_devnet_at}</td><td>{row.ai_model} <span class="muted">({row.ai_model_released})</span></td><td class="number">{row.ai_horizon_minutes} <span class="muted">[{row.ai_horizon_ci[0]}–{row.ai_horizon_ci[1]}]</span></td><td><a href={ai.source_url}><code>{row.ai_metr_key}</code></a></td></tr>)}
        <tr><td>Hegotá</td><td><span class="muted">not yet</span></td><td>{ai.hegota.model} <span class="muted">({ai.hegota.released}; latest measured, lower bound)</span></td><td class="number">≥ {ai.hegota.horizon_minutes} <span class="muted">[{ai.hegota.horizon_ci[0]}–{ai.hegota.horizon_ci[1]}]</span></td><td><a href={ai.source_url}><code>{ai.hegota.metr_key}</code></a></td></tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .explorer-controls { display: grid; gap: 1rem; margin-block: 1rem; }
  .explorer-controls fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 0.75rem 1rem; min-width: 0; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; }
  .chip { border: 1px solid var(--field-line); border-radius: 999px; padding: 0.35rem 0.9rem; background: transparent; color: inherit; cursor: pointer; font: inherit; }
  .chip[aria-pressed='true'] { background: var(--button-bg); border-color: var(--button-bg); color: var(--on-accent); }
  .chip-meta { font-size: 0.8em; opacity: 0.85; }
  .hegota-readout { font-weight: 600; margin: 0.25rem 0 0.5rem; }
  .hegota-eip-group { border: 0; padding: 0; margin: 0.75rem 0 0; }
  .hegota-eip { display: grid; grid-template-columns: auto 1fr auto; gap: 0.5rem; align-items: baseline; padding: 0.15rem 0; }
  .hegota-eip.is-na { opacity: 0.7; }
  .ai-scaling { border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 1rem; }
  .ai-scaling > summary { cursor: pointer; font-weight: 600; }
  .ai-body { margin-top: 0.5rem; }
  .ai-scaling label { display: block; margin-block: .35rem; }
  .ai-more { margin-top: 0.5rem; }
  .ai-more > summary { cursor: pointer; color: var(--accent-dark); font-weight: 600; }
  .ai-info { background: var(--soft); border-left: 0.3rem solid var(--accent); border-radius: 0 6px 6px 0; margin-top: 0.5rem; padding: 0.75rem 1rem; }
  .ai-info h4 { font-size: 0.95rem; margin: 0.9rem 0 0.25rem; }
  .ai-info p { margin: 0.25rem 0; max-width: 78ch; }
  .ai-alpha input { vertical-align: middle; width: min(14rem, 60vw); }
  .band-legend { align-items: center; color: var(--muted); display: flex; flex-wrap: wrap; font-size: .85rem; gap: .35rem .5rem; margin: .5rem 0 0; }
  .band-swatch { background: var(--chart-band); border-radius: 2px; display: inline-block; height: .8rem; width: 1.4rem; }
  .band-50 { opacity: .62; }
  .band-80 { opacity: .4; }
  .band-95 { opacity: .16; margin-left: .2rem; }
  .fit-swatch { border-top: 2px dashed var(--chart-fit); display: inline-block; margin-left: .75rem; width: 1.6rem; }
  .hegota-swatch { border-left: 3px dotted var(--chart-hegota); display: inline-block; height: 1rem; margin-left: .75rem; }
  @media (max-width: 600px) { .hegota-eip { grid-template-columns: auto 1fr; } .hegota-eip .muted { grid-column: 2; } }
</style>

<script>
  import embed from 'vega-embed';
  import { stackedBarHtml } from '../lib/stacked-bar';
  import { THEME_EVENT, chartColors, chartConfig } from '../lib/theme';

  const root = document.querySelector<HTMLElement>('[data-shipping-explorer]');
  if (root) {
    const payload = JSON.parse(root.querySelector('[data-shipping-payload]')!.textContent!);
    const entries: any[] = payload.builder.entries;
    const scored = entries.filter((item) => item.status === 'scored');
    const chart = root.querySelector<HTMLElement>('[data-shipping-chart]')!;
    const readout = root.querySelector<HTMLElement>('[data-hegota-readout]')!;
    const profileHost = root.querySelector<HTMLElement>('[data-hegota-profile]')!;

    const params = new URLSearchParams(location.search);
    const numbers = (value: string | null) => new Set((value ?? '').split(',').map(Number).filter((item) => Number.isInteger(item) && item > 0));
    const state = {
      lists: new Set(params.has('lists') ? (params.get('lists') ?? '').split(',').filter((item) => payload.builder.lists.includes(item)) : payload.builder.default_lists),
      add: numbers(params.get('add')),
      drop: numbers(params.get('drop')),
      ai: (() => { const value = Number(params.get('ai')); return Number.isFinite(value) && value > 0 && value <= 0.3 ? Math.round(value * 100) / 100 : null; })(),
    };
    const aiToggle = root.querySelector<HTMLInputElement>('[data-ai-toggle]')!;
    const aiAlpha = root.querySelector<HTMLInputElement>('[data-ai-alpha]')!;
    const aiAlphaValue = root.querySelector<HTMLOutputElement>('[data-ai-alpha-value]')!;
    const scale = (horizon: number) => (state.ai ? 1 + state.ai * Math.log2(horizon / payload.ai.reference_horizon_minutes) : 1);

    /** Ordinary least squares with nested central prediction bands, as in the adapter. */
    function fitBands(points: { x: number; y: number }[], xMax: number, quantiles: Record<string, number>) {
      const n = points.length;
      const xMean = points.reduce((sum, p) => sum + p.x, 0) / n;
      const yMean = points.reduce((sum, p) => sum + p.y, 0) / n;
      const sxx = points.reduce((sum, p) => sum + (p.x - xMean) ** 2, 0);
      const slope = points.reduce((sum, p) => sum + (p.x - xMean) * (p.y - yMean), 0) / sxx;
      const intercept = yMean - slope * xMean;
      const se = Math.sqrt(points.reduce((sum, p) => sum + (p.y - intercept - slope * p.x) ** 2, 0) / (n - 2));
      return Array.from({ length: 61 }, (_, step) => {
        const x = (xMax * step) / 60;
        const fit = intercept + slope * x;
        const spread = se * Math.sqrt(1 + 1 / n + (x - xMean) ** 2 / sxx);
        const point: Record<string, number> = { x, fit };
        for (const [level, t] of Object.entries(quantiles)) {
          point[`lower_${level}`] = fit - t * spread;
          point[`upper_${level}`] = fit + t * spread;
        }
        return point;
      });
    }

    const selected = () => scored.filter((item) => (state.lists.has(item.list) && !state.drop.has(item.eip)) || state.add.has(item.eip));

    function writeUrl() {
      const next = new URLSearchParams(location.search);
      for (const key of ['eval', 'lists', 'add', 'drop', 'ai']) next.delete(key);
      const lists = payload.builder.lists.filter((item: string) => state.lists.has(item));
      if (lists.join(',') !== payload.builder.default_lists.join(',')) next.set('lists', lists.join(','));
      const add = [...state.add].filter((eip) => !state.lists.has(scored.find((item) => item.eip === eip)?.list)).sort((a, b) => a - b);
      const drop = [...state.drop].filter((eip) => state.lists.has(scored.find((item) => item.eip === eip)?.list)).sort((a, b) => a - b);
      state.add = new Set(add);
      state.drop = new Set(drop);
      if (add.length) next.set('add', add.join(','));
      if (drop.length) next.set('drop', drop.join(','));
      if (state.ai) next.set('ai', state.ai.toFixed(2));
      const query = next.toString();
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    }

    function spec(total: number, count: number) {
      const evaluation = payload.evaluation;
      const showHegota = count > 0;
      const c = chartColors();
      const points = evaluation.rows.map((row: any) => ({ ...row, x: Math.round((row.total_score / scale(row.ai_horizon_minutes)) * 10) / 10 }));
      const marker = state.ai ? Math.round((total / scale(payload.ai.hegota.horizon_minutes)) * 10) / 10 : total;
      const forkMax = Math.max(...points.map((row: any) => row.x));
      const domainMax = Math.ceil((Math.max(forkMax, showHegota ? marker : 0) * 1.15) / 50) * 50;
      const source = state.ai ? fitBands(points.map((row: any) => ({ x: row.x, y: row.shipping_days })), domainMax, evaluation.fit.t_quantiles) : evaluation.fit.band;
      const band = source
        .filter((point: any) => point.x <= domainMax + 1e-9)
        .map((point: any) => ({ ...point, lower_50: Math.max(0, point.lower_50), lower_80: Math.max(0, point.lower_80), lower_95: Math.max(0, point.lower_95) }));
      const narrow = chart.clientWidth < 480;
      const subject = narrow ? 'initial-scope complexity' : 'complexity score sum of the initial fork scope';
      const title = state.ai ? `AI-scaled ${subject} (α = ${state.ai.toFixed(2)})` : `${subject[0].toUpperCase()}${subject.slice(1)} (${evaluation.label})`;
      const x = { field: 'x', type: 'quantitative', title, scale: { zero: true, domain: [0, domainMax], nice: false } };
      const y = { type: 'quantitative', title: 'Days: first ≥2-EL devnet → mainnet', scale: { zero: true } };
      const width = Math.max(180, Math.min(620, chart.clientWidth - 110));
      const tooltip = [
        { field: 'fork_name', title: 'Fork', type: 'nominal' },
        { field: 'total_score', title: 'Initial-scope score', type: 'quantitative' },
        ...(state.ai ? [{ field: 'x', title: 'AI-scaled score', type: 'quantitative' }, { field: 'ai_model', title: 'Frontier model at devnet', type: 'nominal' }, { field: 'ai_horizon_minutes', title: '50% horizon (min)', type: 'quantitative' }] : []),
        { field: 'shipping_days', title: 'Shipping span (days)', type: 'quantitative' },
        { field: 'mainnet_at', title: 'Mainnet', type: 'nominal' },
        { field: 'projected', title: 'Projected', type: 'nominal' },
      ];
      return {
        $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
        width,
        height: Math.round(width * 0.8),
        layer: [
          ...([[95, 0.16], [80, 0.24], [50, 0.36]] as const).map(([level, opacity]) => ({
            data: { values: band },
            mark: { type: 'area', color: c.band, opacity },
            encoding: { x, y: { ...y, field: `lower_${level}` }, y2: { field: `upper_${level}` } },
          })),
          { data: { values: band }, mark: { type: 'line', color: c.fit, strokeDash: [6, 4], strokeWidth: 1.5 }, encoding: { x, y: { ...y, field: 'fit' } } },
          { data: { values: points.filter((row: any) => !row.projected) }, mark: { type: 'point', filled: true, size: 130, color: c.point, stroke: c.surface, strokeWidth: 1 }, encoding: { x, y: { ...y, field: 'shipping_days' }, tooltip } },
          { data: { values: points.filter((row: any) => row.projected) }, mark: { type: 'point', filled: false, size: 150, strokeWidth: 2.5, color: c.point }, encoding: { x, y: { ...y, field: 'shipping_days' }, tooltip } },
          { data: { values: points }, mark: { type: 'text', align: 'left', dx: 8, fontSize: 11, color: c.ink }, encoding: { x, y: { ...y, field: 'shipping_days' }, text: { field: 'fork_short' } } },
          ...(showHegota
            ? [
                { data: { values: [{ x: marker }] }, mark: { type: 'rule', color: c.hegota, strokeWidth: 2.5, strokeDash: [2, 3] }, encoding: { x, tooltip: [{ field: 'x', title: 'Hegotá scenario total', type: 'quantitative' }] } },
                { data: { values: [{ x: marker, label: state.ai ? `Hegotá scenario: ${total} → ≤ ${marker} AI-scaled` : `Hegotá scenario: ${total}` }] }, mark: { type: 'text', color: c.hegota, align: marker > domainMax * 0.7 ? 'right' : 'left', dx: marker > domainMax * 0.7 ? -6 : 6, dy: 8, baseline: 'top', fontWeight: 'bold', fontSize: 12 }, encoding: { x, y: { value: 0 }, text: { field: 'label' } } },
              ]
            : []),
        ],
        config: chartConfig(),
      };
    }

    let pending = 0;
    function render() {
      const chosen = selected();
      const total = chosen.reduce((sum, item) => sum + item.score, 0);
      const na = entries.filter((item) => item.status === 'not_applicable' && state.lists.has(item.list)).length;
      const unassessed = entries.filter((item) => item.status === 'not_assessed' && state.lists.has(item.list)).length;
      readout.textContent = `EL-rubric total ${total} across ${chosen.length} scored EIP${chosen.length === 1 ? '' : 's'}` + (na ? `; ${na} not applicable to the EL rubric` : '')
        + (unassessed ? `; ${unassessed} not yet assessed` : '')
        + (state.ai && chosen.length ? `; AI-scaled at most ${Math.round((total / scale(payload.ai.hegota.horizon_minutes)) * 10) / 10}` : '');
      const sums = new Map<string, number>();
      for (const item of chosen) for (const criterion of item.criteria) sums.set(criterion.id, (sums.get(criterion.id) ?? 0) + criterion.score);
      profileHost.innerHTML = stackedBarHtml({ segments: [...sums].map(([id, score]) => ({ id, score })), labels: payload.labels, total, size: 'large', label: 'Hegotá scenario EL-rubric complexity', showTotal: true });
      for (const button of root!.querySelectorAll<HTMLButtonElement>('[data-hegota-list]')) button.setAttribute('aria-pressed', String(state.lists.has(button.dataset.hegotaList!)));
      for (const box of root!.querySelectorAll<HTMLInputElement>('[data-hegota-eip]')) {
        if (box.disabled) continue;
        box.checked = chosen.some((item) => item.eip === Number(box.dataset.hegotaEip));
      }
      if (state.ai !== null) root!.querySelector<HTMLDetailsElement>('[data-ai-panel]')!.open = true;
      aiToggle.checked = state.ai !== null;
      aiAlpha.disabled = state.ai === null;
      if (state.ai !== null) aiAlpha.value = String(state.ai);
      aiAlphaValue.textContent = Number(aiAlpha.value).toFixed(2);
      const ticket = ++pending;
      embed(chart, spec(total, chosen.length) as any, { actions: false, renderer: 'svg' })
        .then(() => { if (ticket === pending) chart.querySelector('.chart-status')?.remove(); })
        .catch((error) => { chart.textContent = `Chart unavailable: ${error.message}`; });
    }

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-hegota-list]');
      if (button) {
        const list = button.dataset.hegotaList!;
        if (state.lists.has(list)) state.lists.delete(list);
        else state.lists.add(list);
        for (const item of scored.filter((entry) => entry.list === list)) { state.add.delete(item.eip); state.drop.delete(item.eip); }
        writeUrl();
        render();
      }
      if ((event.target as HTMLElement).closest('[data-copy-scenario]')) {
        const status = root!.querySelector<HTMLElement>('[data-copy-status]')!;
        navigator.clipboard?.writeText(location.href).then(
          () => { status.textContent = 'Link copied.'; },
          () => { status.textContent = location.href; },
        );
      }
    });
    root.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target === aiToggle) state.ai = aiToggle.checked ? Number(aiAlpha.value) : null;
      if (target.dataset.hegotaEip) {
        const eip = Number(target.dataset.hegotaEip);
        const listed = state.lists.has(target.dataset.list!);
        if (target.checked) { state.drop.delete(eip); if (!listed) state.add.add(eip); }
        else { state.add.delete(eip); if (listed) state.drop.add(eip); }
      }
      writeUrl();
      render();
    });
    aiAlpha.addEventListener('input', () => {
      if (state.ai === null) return;
      state.ai = Number(aiAlpha.value);
      writeUrl();
      render();
    });
    let resizeTimer = 0;
    let lastWidth = chart.clientWidth;
    new ResizeObserver(() => {
      if (Math.abs(chart.clientWidth - lastWidth) < 8) return;
      lastWidth = chart.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(render, 150);
    }).observe(chart);
    document.addEventListener(THEME_EVENT, render);
    render();
  }
</script>
