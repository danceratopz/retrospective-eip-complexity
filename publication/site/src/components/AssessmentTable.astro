---
import { basePath } from '../lib/data.js';
const { rows, caption = 'Complexity Assessments', controls = false, rowAnchors = false, forkContext = false, sortable = false, proposalRoute = 'assessment' } = Astro.props;
const levelSort = (value: string | null | undefined) => value === 'low' ? '1-low' : value === 'medium' ? '2-medium' : value === 'high' ? '3-high' : `4-${value ?? ''}`;
const forkNames: Record<string, string> = { shanghai: 'Shanghai / Shapella', cancun: 'Cancun / Dencun', prague: 'Prague / Pectra', osaka: 'Osaka / Fusaka', amsterdam: 'Amsterdam / Glamsterdam', hegota: 'Hegotá' };
const forkLabel = (fork: string) => forkNames[fork] ?? fork;
const forkOptions = [...new Set<string>(rows.map((row: { fork: string }) => row.fork))].sort((left, right) => forkLabel(left).localeCompare(forkLabel(right)));
---
{controls && (
  <div class="table-tools" data-table-controls>
    <label>Search assessments <input type="search" data-table-search placeholder="EIP, title, or fork" /></label>
    {forkOptions.length > 1 && <label>Fork <select data-table-fork><option value="">All forks</option>{forkOptions.map((fork) => <option value={fork}>{forkLabel(fork)}</option>)}</select></label>}
    <label class="checkbox"><input type="checkbox" data-retrospective-only /> Retrospective only</label>
    <span class="muted" data-result-count aria-live="polite">{rows.length} relationships</span>
  </div>
)}
<div class="table-region" role="region" aria-label={caption} tabindex="0">
  <table data-assessment-table data-sortable-table={sortable || undefined}>
    <caption>{caption}</caption>
    <thead><tr>{!forkContext && <th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortStudy">Study</button> : 'Study'}</th>}<th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortProposal" data-sort-kind="number">Proposal</button> : 'Proposal'}</th>{!forkContext && <th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortFork">Fork</button> : 'Fork'}</th>}<th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortLayers">Layers</button> : 'Layers'}</th><th scope="col" class="number" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortScore" data-sort-kind="number">Score</button> : 'Score'}</th><th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortTier">Tier/status</button> : 'Tier/status'}</th><th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortConfidence">Confidence</button> : 'Confidence'}</th><th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortUnderSpecified">Under-specified</button> : 'Under-specified'}</th>{forkContext && <th scope="col" aria-sort={sortable ? 'none' : undefined}>{sortable ? <button class="sort-button" type="button" data-sort-key="sortAssessment">Assessment input</button> : 'Assessment input'}</th>}</tr></thead>
    <tbody>
      {rows.map((row) => (
        <tr id={rowAnchors ? `eip-${row.eip}` : undefined} data-mode={row.mode} data-fork={row.fork} data-search={`${row.eip} ${row.title} ${row.fork} ${forkLabel(row.fork)}`.toLowerCase()} data-sort-study={row.mode} data-sort-proposal={row.eip} data-sort-fork={forkLabel(row.fork)} data-sort-layers={row.layers.join(', ')} data-sort-score={row.score ?? ''} data-sort-tier={levelSort(row.tier ?? row.status)} data-sort-confidence={levelSort(row.confidence)} data-sort-under-specified={row.under_specification === null ? '' : row.under_specification ? 'yes' : 'no'} data-sort-assessment={row.assessed_revision_at ?? ''}>
          {!forkContext && <td><span class:list={["pill", row.mode === 'prospective' && 'prospective']}>{row.mode}</span></td>}
          <td><a href={basePath(proposalRoute === 'global' ? `eips/${row.eip}/` : row.assessment_route)}>EIP-{row.eip}: {row.title}</a>{row.rationale && <p class="muted">{row.rationale}</p>}</td>
          {!forkContext && <td>{forkLabel(row.fork)}</td>}
          <td>{row.layers.join(', ')}</td>
          <td class="number">{row.score ?? '—'}</td>
          <td>{row.tier ? <span class:list={["pill", row.tier]}>{row.tier}</span> : <span class="pill na">N/A</span>}</td>
          <td>{row.confidence ?? '—'}</td>
          <td>{row.under_specification === null ? '—' : row.under_specification ? 'Yes' : 'No'}</td>
          {forkContext && <td class="revision-links"><a href={row.assessed_revision_url}>Assessed <code>{row.assessed_revision.slice(0, 10)}</code></a><span class="muted">{row.assessed_revision_at.slice(0, 10)}</span><a href={row.current_revision_url}>Current master</a><a href={row.revision_history_url}>File history</a></td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>
{sortable && (
  <script>
    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
    for (const table of document.querySelectorAll<HTMLTableElement>('[data-sortable-table]:not([data-sort-ready])')) {
      table.setAttribute('data-sort-ready', 'true');
      const body = table.tBodies[0];
      const rows = Array.from(body.rows);
      rows.forEach((row, index) => { row.dataset.sortIndex = String(index); });
      for (const button of table.querySelectorAll<HTMLButtonElement>('[data-sort-key]')) {
        button.addEventListener('click', () => {
          const header = button.closest('th');
          const key = button.dataset.sortKey;
          if (!header || !key) return;
          const direction = header.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
          const multiplier = direction === 'ascending' ? 1 : -1;
          rows.sort((left, right) => {
            const leftValue = left.dataset[key] ?? '';
            const rightValue = right.dataset[key] ?? '';
            if (!leftValue || !rightValue) {
              if (!leftValue && !rightValue) return Number(left.dataset.sortIndex) - Number(right.dataset.sortIndex);
              return !leftValue ? 1 : -1;
            }
            const comparison = button.dataset.sortKind === 'number'
              ? Number(leftValue) - Number(rightValue)
              : collator.compare(leftValue, rightValue);
            return comparison ? comparison * multiplier : Number(left.dataset.sortIndex) - Number(right.dataset.sortIndex);
          });
          for (const item of table.querySelectorAll<HTMLElement>('th[aria-sort]')) item.setAttribute('aria-sort', 'none');
          header.setAttribute('aria-sort', direction);
          body.append(...rows);
        });
      }
    }
  </script>
)}
{controls && (
  <script>
    const controls = document.querySelector<HTMLElement>('[data-table-controls]');
    const table = document.querySelector<HTMLTableElement>('[data-assessment-table]');
    if (controls && table) {
      const search = controls.querySelector<HTMLInputElement>('[data-table-search]');
      const fork = controls.querySelector<HTMLSelectElement>('[data-table-fork]');
      const retrospectiveOnly = controls.querySelector<HTMLInputElement>('[data-retrospective-only]');
      const count = controls.querySelector<HTMLElement>('[data-result-count]');
      if (!search || !fork || !retrospectiveOnly || !count) throw new Error('Assessment table controls are incomplete');
      const update = () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;
        for (const row of table.tBodies[0].rows) {
          const matchesSearch = !query || row.dataset.search.includes(query);
          const matchesFork = !fork.value || row.dataset.fork === fork.value;
          const matchesMode = !retrospectiveOnly.checked || row.dataset.mode === 'retrospective';
          row.hidden = !(matchesSearch && matchesFork && matchesMode);
          if (!row.hidden) visible += 1;
        }
        count.textContent = `${visible} relationships`;
      };
      search.addEventListener('input', update);
      fork.addEventListener('change', update);
      retrospectiveOnly.addEventListener('change', update);
    }
  </script>
)}
