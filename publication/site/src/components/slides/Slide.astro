---
/** One slide: a full-viewport section. */
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props as Props;
---
<section class:list={['slide', className]} id={id} data-title={title} aria-label={title}>
  <div class="slide-inner">
    <slot />
  </div>
</section>
