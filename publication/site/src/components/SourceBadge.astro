---
import type { Source } from '../lib/domain';
import { SOURCE_DESCRIPTIONS, SOURCE_LABELS, rubricLabel } from '../lib/labels';

interface Props {
  source: Source;
  revision?: number | null;
  size?: 'small' | 'regular';
}

const { source, revision = null, size = 'regular' } = Astro.props as Props;
---
<span class:list={['source', `source-${source}`, size === 'small' && 'source-small']} title={SOURCE_DESCRIPTIONS[source]}>
  <span class="source-glyph" aria-hidden="true">{source === 'human' ? '⚇' : '⌬'}</span>
  <span>{SOURCE_LABELS[source]}</span>
  {revision && <span class="source-revision">{rubricLabel(revision)}</span>}
</span>
