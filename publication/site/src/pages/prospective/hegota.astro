---
import Layout from '../../layouts/Layout.astro';
import ForkPage from '../../components/ForkPage.astro';
import { loadPublication } from '../../lib/data.js';
import type { Publication } from '../../lib/domain';
import { forkSummary } from '../../lib/domain';

const data = loadPublication() as Publication;
const fork = forkSummary(data, 'hegota');
---
<Layout title="Hegotá prospective assessment" description="Prospective Execution Layer complexity assessment of the Hegotá candidate EIPs at the 2026-08-26 snapshot, with the status of the STEEL human checklists for each candidate.">
  <ForkPage data={data} fork={fork} />
</Layout>
