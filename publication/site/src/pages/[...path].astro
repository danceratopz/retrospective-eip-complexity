---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import AssessmentTable from '../components/AssessmentTable.astro';
import { loadPublication, basePath } from '../lib/data.js';

export function getStaticPaths() {
  const data = loadPublication();
  const pages: [string, any][] = [
    ['study', { kind: 'study' }],
    ['forks', { kind: 'fork-index' }],
    ['eips', { kind: 'eip-index' }],
    ['results/predicted-complexity', { kind: 'result', result: 'predicted' }],
    ['results/observed-effort', { kind: 'result', result: 'observed' }],
    ['results/predicted-vs-observed', { kind: 'result', result: 'association' }],
    ['results/human-automated-alignment', { kind: 'result', result: 'alignment' }],
    ['prospective/hegota', { kind: 'hegota' }],
  ];
  for (const fork of data.forks.filter((item) => item.fork !== 'hegota')) pages.push([`forks/${fork.fork}`, { kind: 'fork', fork: fork.fork }]);
  for (const row of data.assessments.filter((item) => item.mode === 'retrospective')) pages.push([`forks/${row.fork}/eips/${row.eip}`, { kind: 'assessment', fork: row.fork, eip: row.eip }]);
  for (const eip of data.eips) pages.push([`eips/${eip.eip}`, { kind: 'eip', eip: eip.eip }]);
  return pages.map(([path, props]) => ({ params: { path }, props }));
}

const props = Astro.props as any;
const data = loadPublication();
const studyTitle = 'Can Execution Layer Complexity Assessments Help Predict Time to Mainnet?';
const studySections = [
  {
    id: 'background',
    title: 'Background',
    body: [
      'Testing is frequently the critical path. Before the first devnet, implementing Execution Layer consensus tests and their supporting test frameworks, then ensuring those tests agree with client implementations, is costly. Once devnets begin, interoperability testing across Execution Layer clients, debugging, and repeated integration cycles can dominate the remaining time to mainnet.',
    ],
  },
  {
    id: 'research-question',
    title: 'Research Question',
    body: [
      'This study asks whether complexity assessments made from early Execution Layer EIP specifications can help anticipate that broader delivery process. The primary fork-level analysis compares three summaries of predicted Execution Layer complexity with the time from the first devnet running at least two independent Execution Layer clients to mainnet.',
      'A separate EIP-level analysis asks whether predicted Execution Layer complexity tracks score-blind public-artifact measures of specification rework, integration exposure, coordination surface, emergent coupling, and relative observed effort.',
    ],
  },
  {
    id: 'evaluations',
    title: 'What Was Evaluated',
    body: [
      'The retrospective study contains 49 fork–EIP relationships whose proposals have an Execution Layer surface, including execution-only and cross-layer EIPs, from Shanghai through Amsterdam. Only the Execution Layer surface is scored. Each relationship is assessed from a pinned proposal revision intended to approximate its entry into fork development.',
      'Hegotá is a separate forward-looking evaluation of the 44 proposals listed as Proposed for Inclusion in EIP-8081 on 26 August 2026. The 37 proposals with an applicable Execution Layer or execution-client networking surface were scored; five Consensus Layer–only proposals and two explicit exclusions were retained as N/A. Its scores were produced with an LLM using the same Execution Layer complexity-assignment rubric, independently of the STEEL team’s ongoing manual assessment work. Hegotá has no observed outcome and never enters the retrospective association analysis.',
    ],
  },
  {
    id: 'workflow',
    title: 'Research Workflow',
    body: [
      'Task 01 records fork membership and source history. Tasks 03 and 04 select and review historical proposal horizons. Task 05 creates sealed one-EIP packages and runs isolated assessments. Task 07 defines observed-effort proxies before joining them to scores.',
      'Every derived publication record points back to a repository-relative source path and SHA-256. The publication adapter reads research outputs but cannot modify them.',
    ],
  },
  {
    id: 'evidence-controls',
    title: 'Evidence Controls',
    body: [
      'Each assessor received one sealed proposal package, the pinned rubric, and explicitly admitted supporting documents. Network access, repository access, other assessments, implementations, tests, observed outcomes, and aggregate progress were excluded.',
      'Isolation cannot erase latent model knowledge. The study therefore reports package provenance, exposure attestations, under-specification, confidence, and known recovery events instead of claiming perfect blindness.',
    ],
  },
  {
    id: 'scoring-rubric',
    title: 'Scoring Rubric',
    body: [
      'Twenty-eight Execution Layer criteria produce a primary score and Low, Medium, or High tier. Scores below 12 are Low, 12 through 22 are Medium, and 23 or above are High. The criteria cover gas rules, execution and state behavior, testing surfaces, APIs, encodings, system contracts, opcodes, precompiles, transactions, activation, performance, security, under-specified behavior, and cross-EIP interactions.',
      'The rubric estimates specification-implied Execution Layer complexity. It does not estimate person-hours, cost, severity, importance, Consensus Layer complexity, or probability of inclusion.',
    ],
  },
  {
    id: 'study-design-decisions',
    title: 'Study Design Decisions',
    body: [
      'The study favors pinned evidence and explicit limitations over a larger but less controlled sample.',
      'The research uses fork–EIP relationships rather than unique EIPs because one proposal can appear in more than one fork context. Consensus Layer–only proposals remain visible but never receive a zero EL score.',
      'Observed-effort metrics were defined score-blind. Correlations remain descriptive: they do not show that complexity caused delay, revisions, coordination, or engineering effort.',
    ],
  },
];
const studyLimitations = [
  'Complexity scores do not measure person-hours, cost, importance, risk, or causality.',
  'Fork totals depend on the number of included EIPs and how proposals are split.',
  'Historical ref selection approximates entry into development and can be imperfect.',
  'Observed-effort proxies are derived from recorded public artifacts and omit private work.',
  'Amsterdam is right-censored and potentially in-sample.',
  'Hegotá is forward-looking, can change after the snapshot, and has no observed outcome.',
  'Consensus Layer–only work receives no EL score; zero would be misleading.',
  'Isolation reduces observable hindsight but cannot erase latent model knowledge.',
];
const titles = {
  'fork-index': 'Forks', 'eip-index': 'EIPs', fork: 'Fork detail', assessment: 'Assessment detail', eip: 'EIP detail',
  hegota: 'Hegotá prospective assessment', result: 'Results', study: studyTitle,
};
let title = titles[props.kind] ?? 'Research';
const fork = props.fork ? data.forks.find((item) => item.fork === props.fork) : null;
const forkRows = props.fork ? data.assessments.filter((item) => item.fork === props.fork) : [];
const assessment = props.kind === 'assessment' ? data.assessments.find((item) => item.fork === props.fork && item.eip === props.eip) : null;
const eip = props.kind === 'eip' ? data.eips.find((item) => item.eip === props.eip) : null;
if (fork && props.kind === 'fork') title = fork.name;
if (assessment) title = `EIP-${assessment.eip}: ${assessment.title}`;
if (eip) title = `EIP-${eip.eip}: ${eip.title}`;
const resultTitles = { predicted: 'Predicted complexity', observed: 'Observed-effort proxies', association: 'Predicted versus observed', alignment: 'Human–automated alignment' };
if (props.kind === 'result') title = resultTitles[props.result];
const hegotaRows = data.assessments.filter((item) => item.fork === 'hegota');
const forkShipping = data.fork_shipping;
const correlations = [
  ['Delivery lead time', 34, 0.56], ['Specification rework', 49, 0.70], ['Integration exposure', 49, 0.40],
  ['Coordination surface', 49, 0.49], ['Emergent coupling', 49, 0.56], ['Observed-effort composite v0', 49, 0.58],
];
---
<Layout title={title}>
  {props.kind === 'study' && <>
    <p class="eyebrow">Methodology</p>
    <h1>{studyTitle}</h1>
    <p class="lede">We used an LLM to perform retrospective complexity assessments from early Execution Layer EIP specifications, then tested whether those scores help explain how long a fork takes to reach mainnet and the later engineering burden visible in public artifacts.</p>
    <nav class="actions" aria-label="Study sections">
      {studySections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
      <a href="#limitations">Limitations</a>
    </nav>
    {studySections.map((section) => <section aria-labelledby={section.id}><h2 id={section.id}>{section.title}</h2>{section.id === 'background' && <p>The <a href="https://steel.ethereum.foundation/">STEEL team</a> introduced its <a href="https://github.com/ethspecs/pm/blob/3d8c0128c5543dd3146341ef395aa344e4abea30/Templates/EIP-Complexity-Assessment.md">Execution Layer EIP complexity-assessment methodology</a> during the Amsterdam fork-scoping process to make the difficulty of implementing, testing, coordinating, and shipping the Execution Layer surface of an EIP to mainnet more legible before scope decisions are made.</p>}{section.body.map((paragraph) => <p>{paragraph}</p>)}</section>)}
    <section aria-labelledby="limitations"><h2 id="limitations">Limitations</h2><p>The results are evidence about a research rubric, not a universal measure of protocol work.</p><ul>{studyLimitations.map((limitation) => <li>{limitation}</li>)}</ul></section>
  </>}

  {props.kind === 'fork-index' && <>
    <p class="eyebrow">Complexity Evaluations</p><h1>Forks</h1><p class="lede">Five retrospective fork evaluations of Execution Layer complexity and one forward-looking Execution Layer complexity evaluation for Hegotá.</p>
    <div class="grid">{data.forks.map((item) => <article class="card"><span class:list={["pill", item.mode === 'prospective' && 'prospective']}>{item.mode}</span><h2>{item.name}</h2><p><strong>{item.scored_count}</strong> scored · <strong>{item.not_applicable_count}</strong> N/A · score sum <strong>{item.score_sum}</strong></p><a href={basePath(item.fork === 'hegota' ? 'prospective/hegota/' : `forks/${item.fork}/`)}>View fork →</a></article>)}</div>
  </>}

  {props.kind === 'fork' && <>
    <p class="eyebrow">Retrospective Fork Evaluation</p><h1>{fork.name}</h1><p class="lede">{fork.scored_count} execution-layer assessments with a score sum of {fork.score_sum}.</p>
    <nav class="fork-nav" aria-label="Fork Navigation" data-fork-nav>
      <span class="fork-nav-label">Forks</span>
      {data.forks.map((item) => <a href={basePath(item.fork === 'hegota' ? 'prospective/hegota/' : `forks/${item.fork}/`)} aria-current={item.fork === fork.fork ? 'page' : undefined} data-fork-link>{item.name}</a>)}
    </nav>
    {fork.fork === 'amsterdam' && <div class="caveat"><strong>Right-censored and potentially in-sample.</strong> Amsterdam’s observation window ends before its final outcome.</div>}
    <h2 id="complexity-assessments">Complexity Assessments</h2>
    <p>Each assessment was automated using the GPT-5.6 Sol LLM at xhigh reasoning effort, evaluating the EIP revision linked in the Assessment Input column against <a href="https://github.com/ethspecs/pm/blob/3d8c0128c5543dd3146341ef395aa344e4abea30/Templates/EIP-Complexity-Assessment.md">version 2 of STEEL’s complexity-assignment template</a>.</p>
    <AssessmentTable rows={forkRows} caption={`${fork.name} Complexity Assessments`} forkContext={true} sortable={true} />
    <h2 id="historical-refs">How the Historical Refs Were Selected</h2>
    <p>These timelines support the assessment table by showing the fork chronology and the revision and inclusion history used to choose each input. They are process evidence, not additional complexity results. Each chart has its own time axis; horizontal positions should only be compared within a chart.</p>
    <h3 id="fork-milestones">Fork Milestones and Relevant Devnets</h3>
    <Chart spec={data.charts[`fork-milestones-${fork.fork}`]} label={`Fork milestones and relevant devnets for ${fork.name}`} description="Fork-level scope, devnet, testnet, and activation milestones on an independent time axis." fit={true} />
    <h3 id="eip-revision-histories">EIP Revision Histories and Selected Assessment Refs</h3>
    <p>The main purpose of this panel is to show where the selected assessment ref (REF) falls in each EIP’s revision history. The other traces and markers provide context for that selection. Every EIP row uses the same date scale, shown once above the panel.</p>
    <ul><li><strong>Revision traces:</strong> the dark line counts substantive post-creation revisions; the faint line counts all revisions.</li><li><strong>REF:</strong> the immutable EIP revision used for assessment. The amber rule is its proposal anchor.</li><li><strong>PFI, CFI, and SFI:</strong> recorded fork-inclusion state transitions; open markers retain repeated same-state records.</li><li><strong>CUTOFF:</strong> the fork-level initial-evaluation horizon. Triangles identify relevant devnets or testnets.</li></ul>
    <Chart spec={data.charts[`timeline-${fork.fork}`]} label={`EIP revision histories supporting historical assessment-ref selection for ${fork.name}`} description="Aligned EIP revision histories, inclusion-state transitions, selected assessment refs, and the fork evaluation cutoff on one shared time axis." fit={true} />
  </>}

  {props.kind === 'assessment' && <>
    <p class="eyebrow">Retrospective assessment</p><h1>EIP-{assessment.eip}: {assessment.title}</h1><p class="lede">{assessment.summary}</p>
    <div class="source-note"><strong>Assessment input:</strong> <a href={assessment.assessed_revision_url}>immutable EIP revision <code>{assessment.assessed_revision.slice(0, 10)}</code></a> from {assessment.assessed_revision_at.slice(0, 10)} · <a href={assessment.current_revision_url}>current master</a> · <a href={assessment.revision_history_url}>file history</a></div>
    <div class="grid"><div class="card"><span class="muted">Primary score</span><div class="stat">{assessment.score}</div></div><div class="card"><span class="muted">Tier</span><p><span class:list={["pill", assessment.tier]}>{assessment.tier}</span></p></div><div class="card"><span class="muted">Confidence</span><div class="stat">{assessment.confidence}</div></div><div class="card"><span class="muted">Under-specified</span><div class="stat">{assessment.under_specification ? 'Yes' : 'No'}</div></div></div>
    <h2>Criterion scores</h2><ul class="criterion-grid">{assessment.criteria.map((criterion) => <li><span>{criterion.label}</span><strong>{criterion.score}</strong></li>)}</ul>
    <h2>Uncertainty</h2><p>{assessment.under_specification_summary}</p>
  </>}

  {props.kind === 'eip-index' && <>
    <p class="eyebrow">Cross-fork index</p><h1>EIPs</h1><p class="lede">{data.eips.length} proposals represented across 93 fork–EIP relationships.</p>
    <AssessmentTable rows={data.assessments} caption="EIP complexity assessments" controls={true} sortable={true} proposalRoute="global" />
  </>}

  {props.kind === 'eip' && <>
    <p class="eyebrow">Proposal Across Forks</p><h1>EIP-{eip.eip}: {eip.title}</h1>
    <div class="grid">{eip.relationships.map((rel) => <article class="card"><span class:list={["pill", rel.mode === 'prospective' && 'prospective']}>{rel.mode}</span><h2>{rel.fork === 'hegota' ? 'Hegotá' : rel.fork}</h2><p>{rel.status === 'scored' ? <>Score <strong>{rel.score}</strong> · <span class:list={["pill", rel.tier]}>{rel.tier}</span></> : <span class="pill na">Not applicable</span>}</p></article>)}</div>
  </>}

  {props.kind === 'result' && props.result === 'predicted' && <>
    <p class="eyebrow">Rubric output</p><h1>Predicted complexity</h1><p class="lede">All 49 retrospective assessments and the separate 44-entry Hegotá prospective snapshot, using the same EL rubric.</p>
    <Chart spec={data.charts['fork-totals']} label="Historical fork score totals" description="Retrospective score sums only. They reflect proposal counts and splitting choices as well as assessed complexity." />
    <AssessmentTable rows={data.assessments} caption="All fork–EIP complexity assessments" controls={true} />
    <div class="actions"><a class="button" href={basePath('generated/downloads/complexity-assessments.csv')}>Download CSV</a></div>
  </>}

  {props.kind === 'result' && props.result === 'association' && <>
    <p class="eyebrow">Primary retrospective result</p><h1>Does Predicted Complexity Track Time to Mainnet?</h1>
    <p class="lede">At fork level, the study compares the time from development underway in earnest—the first devnet with at least two independent execution-layer clients—to mainnet against three summaries of predicted complexity.</p>
    <div class="caveat"><strong>Five forks, descriptive only.</strong> Amsterdam uses the projected 15 December 2026 mainnet date and is potentially in-sample. Correlation does not establish that complexity caused delivery time; one fork can materially change these coefficients.</div>
    <h2>Fork shipping span</h2>
    <Chart spec={data.charts['fork-shipping']} label="Three scatter plots comparing fork shipping span with summed complexity, High-tier complexity, and the hardest single EIP" description="Filled points are four shipped forks. The open Amsterdam point uses a projected mainnet date. The development clock starts at the first devnet running at least two independent EL implementations." />
    <div class="grid" aria-label="Fork-level correlation summary">
      {forkShipping.correlations.map((item) => <article class="card"><p class="eyebrow">{item.label}</p><div class="stat">ρ {item.spearman_rho.toFixed(2)}</div><p class="muted">Pearson r {item.pearson_r.toFixed(2)} · n = 5 forks</p></article>)}
    </div>
    <div class="table-region" role="region" aria-label="Fork shipping data" tabindex="0"><table><caption>Fork-level values plotted above</caption><thead><tr><th scope="col">Fork</th><th scope="col">First ≥2-EL devnet</th><th scope="col">Mainnet</th><th scope="col" class="number">Days</th><th scope="col" class="number">Total score</th><th scope="col" class="number">High-tier sum</th><th scope="col" class="number">Hardest EIP</th></tr></thead><tbody>{forkShipping.rows.map((row) => <tr data-shipping-fork={row.fork}><td>{row.fork_name}{row.projected && ' (projected)'}</td><td>{row.first_multi_el_devnet}<br /><span class="muted">{row.first_multi_el_devnet_at}</span></td><td>{row.mainnet_at}</td><td class="number">{row.shipping_days}</td><td class="number">{row.total_score}</td><td class="number">{row.high_tier_score_sum}</td><td class="number">{row.hardest_eip}: {row.max_score}</td></tr>)}</tbody></table></div>
    <p class="muted">Cancun is the only fork whose ≥2-EL start differs from its first EL devnet: devnets 1–3 ran a single patched geth fork, so this clock begins at dencun-devnet-4. Cancun also largely distinguishes the total-load and critical-path readings in this five-fork sample.</p>
    <h2>EIP-level observed proxies</h2>
    <p>As a separate view, each retrospective fork–EIP relationship is compared with score-blind public-artifact proxies for rework, integration, coordination, emergent coupling, and relative observed effort.</p>
    <Chart spec={data.charts['predicted-observed']} label="Faceted scatter plots comparing predicted complexity with observed-effort proxies" description="Each point is one of the 49 retrospective fork–EIP relationships; outlined encoding identifies censored Amsterdam observations." />
    <div class="table-region" role="region" aria-label="Rank correlations" tabindex="0"><table><caption>Overall EIP-level Spearman rank correlations</caption><thead><tr><th scope="col">Metric</th><th scope="col" class="number">N</th><th scope="col" class="number">Spearman ρ</th></tr></thead><tbody>{correlations.map((row) => <tr><td>{row[0]}</td><td class="number">{row[1]}</td><td class="number">{Number(row[2]).toFixed(2)}</td></tr>)}</tbody></table></div>
    <div class="actions"><a href={basePath('results/predicted-complexity/')}>Browse predicted scores</a><a href={basePath('results/observed-effort/')}>How observed proxies are defined</a><a href={basePath('results/human-automated-alignment/')}>Human–automated alignment</a></div>
  </>}

  {props.kind === 'result' && props.result === 'observed' && <>
    <p class="eyebrow">Score-blind measurements</p><h1>{resultTitles[props.result]}</h1><p class="lede">Public-artifact proxies describe specification rework, integration exposure, coordination surface, emergent coupling, and delivery timing. They are not person-hours or causal effects.</p>
    <div class="caveat">Hegotá is excluded because it has no observed outcome. Amsterdam is right-censored and potentially in-sample.</div>
    <Chart spec={data.charts['predicted-observed']} label="Faceted scatter plots comparing predicted complexity with observed-effort proxies" description="The five proxy families were selected without reading predicted scores; this chart shows their later descriptive association with the 49 retrospective assessments." />
    <div class="table-region" role="region" aria-label="Rank correlations" tabindex="0"><table><caption>Overall EIP-level Spearman rank correlations</caption><thead><tr><th scope="col">Metric</th><th scope="col" class="number">N</th><th scope="col" class="number">Spearman ρ</th></tr></thead><tbody>{correlations.map((row) => <tr><td>{row[0]}</td><td class="number">{row[1]}</td><td class="number">{Number(row[2]).toFixed(2)}</td></tr>)}</tbody></table></div>
    <div class="actions"><a class="button" href={basePath('results/predicted-vs-observed/')}>See the central relationship analysis</a><a href={`${basePath('study/')}#study-design-decisions`}>Metric-selection decisions</a></div>
  </>}

  {props.kind === 'result' && props.result === 'alignment' && <>
    <p class="eyebrow">Calibration study</p><h1>Human–automated alignment</h1><p class="lede">Twelve reconstructable Amsterdam comparisons, of which only two meet the predeclared clean-input/template/total conditions.</p>
    <Chart spec={data.charts['human-alignment']} label="Scatter plot of historical human and blinded automated scores" description="The 12-point comparison is descriptive; the clean subset is too small for substantive rank-correlation interpretation." />
    <div class="caveat">All reconstructable comparisons: mean absolute error 5.33, signed automated-minus-human bias 2.83, Spearman 0.61, tier agreement 0.17. Confounds remain material.</div>
    <a href={basePath('generated/charts/human-alignment.json')}>Download plotted values and Vega-Lite specification</a>
  </>}

  {props.kind === 'hegota' && <>
    <p class="eyebrow prospective-text">Prospective · frozen 2026-08-26 snapshot</p><h1>Hegotá PFI complexity assessment</h1><p class="lede">EL-rubric total: 776 across 37 scored PFI EIPs. Of 44 PFI entries, five are Consensus Layer–only and two were explicitly excluded; none received a numeric score or tier.</p>
    <div class="notice"><strong>Independent LLM Evaluation.</strong> These scores were produced with an LLM using the same Execution Layer complexity-assignment rubric, independently of the STEEL team’s ongoing manual assessment work.</div>
    <div class="grid"><div class="card"><span class="muted">Scored EL surfaces</span><div class="stat">37</div></div><div class="card"><span class="muted">Not applicable</span><div class="stat">7</div></div><div class="card"><span class="muted">Low / Medium / High</span><div class="stat">4 / 20 / 13</div></div><div class="card"><span class="muted">Under-specified</span><div class="stat">34 / 37</div></div></div>
    <div class="notice"><strong>Common information cutoff:</strong> {data.hegota.information_cutoff_at}. The assessment covers Execution Layer and execution-client networking surfaces only. It does not predict final fork scope or include observed outcomes.</div>
    <h2>Scored proposals</h2><Chart spec={data.charts['hegota-scores']} label="Ranked Hegotá prospective scores" description="Bars encode the 37 applicable execution-layer rubric scores. The seven N/A entries remain in the semantic table below." />
    <AssessmentTable rows={hegotaRows} caption="Hegotá PFI snapshot: scored and not-applicable entries" rowAnchors={true} />
    <h2>Caveats</h2><ul>{data.hegota.caveats.map((caveat) => <li>{caveat}</li>)}</ul>
    <div class="actions"><a class="button" href={basePath('generated/downloads/complexity-assessments.csv')}>Download all assessments</a><a href={basePath('generated/publication.json')}>Publication JSON</a></div>
  </>}
</Layout>
