---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import { loadPublication, basePath } from '../lib/data.js';
const data = loadPublication();
const retrospective = data.forks.filter((fork) => fork.mode === 'retrospective');
---
<Layout title="Research overview">
  <section class="hero">
    <p class="eyebrow">Evaluation-first research publication</p>
    <h1>How much complexity did an EIP imply before implementation?</h1>
    <p class="lede">This study applies one execution-layer complexity rubric to pinned proposal snapshots, then compares the retrospective predictions with independently constructed public-artifact proxies for development history.</p>
    <div class="actions">
      <a class="button" href={basePath('study/')}>Read the methodology</a>
      <a href={basePath('results/predicted-vs-observed/')}>See the central results</a>
    </div>
  </section>
  <section aria-labelledby="study-scope-heading">
    <h2 id="study-scope-heading">Two deliberately separate study branches</h2>
    <div class="grid">
      <article class="card"><p class="eyebrow">Retrospective</p><div class="stat">49</div><h3>fork–EIP relationships</h3><p>Five historical or in-development forks assessed at pinned initial-development horizons.</p></article>
      <article class="card"><p class="eyebrow prospective-text">Prospective</p><div class="stat">44</div><h3>Hegotá PFI entries</h3><p>One common 2026-08-26 snapshot: 37 scored execution surfaces and 7 explicit N/A dispositions.</p></article>
      <article class="card"><p class="eyebrow">Observed history</p><div class="stat">5 + 1</div><h3>score-blind proxies</h3><p>Five selected observed-effort proxies plus one within-fork composite, used descriptively rather than causally.</p></article>
    </div>
  </section>
  <section aria-labelledby="result-heading">
    <h2 id="result-heading">Retrospective complexity by fork</h2>
    <p>The blue subtotal is the complexity that could have been predicted at the fork’s evaluation cutoff and is the primary value used in the shipping-time comparison. The orange increment keeps EIPs added later visible without treating them as part of that initial prediction. Score sums also reflect the number and splitting of EIPs in each fork.</p>
    <Chart spec={data.charts['fork-totals']} label="Stacked bar chart of predicted complexity included by the evaluation cutoff and added afterward for each retrospective fork" description="The initial predicted total and later scope increment are shown separately. Hegotá has its own prospective result page." />
    <div class="table-region" role="region" aria-label="Retrospective fork totals by scope timing" tabindex="0"><table data-sortable-table><caption>Predicted complexity at and after each fork’s evaluation cutoff</caption><thead><tr><th scope="col" aria-sort="none"><button class="sort-button" type="button" data-sort-key="sortFork">Fork</button></th><th scope="col" class="number" aria-sort="none"><button class="sort-button" type="button" data-sort-key="sortAtCutoffCount" data-sort-kind="number">EIPs by cutoff</button></th><th scope="col" class="number" aria-sort="none"><button class="sort-button" type="button" data-sort-key="sortAtCutoffScore" data-sort-kind="number">Score at cutoff</button></th><th scope="col" class="number" aria-sort="none"><button class="sort-button" type="button" data-sort-key="sortLateCount" data-sort-kind="number">EIPs added later</button></th><th scope="col" class="number" aria-sort="none"><button class="sort-button" type="button" data-sort-key="sortLateScore" data-sort-kind="number">Added-later score</button></th><th scope="col" class="number" aria-sort="none"><button class="sort-button" type="button" data-sort-key="sortFinalScore" data-sort-kind="number">Final-scope score</button></th></tr></thead><tbody>{retrospective.map((fork) => <tr data-sort-fork={fork.name} data-sort-at-cutoff-count={fork.at_cutoff_count} data-sort-at-cutoff-score={fork.at_cutoff_score_sum} data-sort-late-count={fork.late_addition_count} data-sort-late-score={fork.late_addition_score_sum} data-sort-final-score={fork.final_scope_score_sum}><td><a href={basePath(`forks/${fork.fork}/`)}>{fork.name}</a></td><td class="number">{fork.at_cutoff_count}</td><td class="number">{fork.at_cutoff_score_sum}</td><td class="number">{fork.late_addition_count}</td><td class="number">{fork.late_addition_score_sum}</td><td class="number">{fork.final_scope_score_sum}</td></tr>)}</tbody></table></div>
  </section>
  <section class="notice" aria-labelledby="hegota-heading">
    <p class="eyebrow prospective-text">Prospective snapshot</p>
    <h2 id="hegota-heading">Hegotá PFI assessment</h2>
    <p><strong>EL-rubric total: 776 across 37 scored PFI EIPs.</strong> Five consensus-only proposals and two explicit owner exclusions have no numeric score or tier.</p>
    <a href={basePath('prospective/hegota/')}>Open the Hegotá assessment →</a>
  </section>
</Layout>
