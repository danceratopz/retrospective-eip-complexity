---
import Layout from '../../layouts/Layout.astro';
import { basePath } from '../../lib/data.js';
import { DECKS } from '../../lib/decks';
---
<Layout title="Slides" description="Presentation decks built from the study's published data.">
  <p class="eyebrow">Presentations</p><h1>Slides</h1>
  <p class="lede">Talks built from the same published data as the rest of the site. Each deck runs in the browser: arrow keys move between slides, F toggles fullscreen and D switches between light and dark.</p>
  <div class="grid">
    {DECKS.map((item) => (
      <article class="card">
        <p class="eyebrow">{item.venue} · {item.date}</p>
        <h2><a href={basePath(`slides/${item.slug}/`)}>{item.title}</a></h2>
        <p class="muted">{item.summary}</p>
      </article>
    ))}
  </div>
</Layout>
