---
import '../styles/global.css';
import SortableTables from '../components/SortableTables.astro';
import Tooltip from '../components/Tooltip.astro';
import { basePath } from '../lib/data.js';
import { criterionCss } from '../lib/criteria';

const { title, description = 'A reproducible evaluation of EIP complexity and observed development history.', redirect } = Astro.props;
const nav = [
  ['Study', ''],
  ['Forks', 'forks/'],
  ['EIPs', 'eips/'],
  ['Results', 'results/predicted-vs-observed/'],
  ['Human vs LLM', 'human-vs-llm/'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {redirect && <meta name="robots" content="noindex" />}
    {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
    <title>{title} · Retrospective LLM-Based Complexity Evaluations</title>
    <style set:html={criterionCss()}></style>
    <script is:inline>
      (() => {
        // Follow the system theme until the reader chooses; a choice equal to the system theme is cleared.
        const root = document.documentElement;
        const media = matchMedia('(prefers-color-scheme: dark)');
        let override = null; // used only when localStorage is unavailable
        const stored = () => {
          try { const value = localStorage.getItem('theme'); return override ?? (value === 'light' || value === 'dark' ? value : null); } catch { return override; }
        };
        const apply = () => {
          const choice = stored();
          if (choice) root.dataset.theme = choice; else delete root.dataset.theme;
          const effective = choice ?? (media.matches ? 'dark' : 'light');
          const changed = Boolean(root.dataset.themeEffective) && root.dataset.themeEffective !== effective;
          root.dataset.themeEffective = effective;
          if (changed) document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: effective } }));
        };
        window.__setTheme = (theme) => {
          const choice = theme === (media.matches ? 'dark' : 'light') ? null : theme;
          try { if (choice) localStorage.setItem('theme', choice); else localStorage.removeItem('theme'); } catch { override = choice ?? (theme === 'dark' ? 'dark' : 'light'); }
          apply();
        };
        media.addEventListener('change', () => { if (!stored()) apply(); });
        apply();
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header>
      <div class="topbar">
        <a class="brand" href={basePath()}>Retrospective LLM-Based Complexity Evaluations</a>
        <nav aria-label="Primary navigation">
          <ul>
            {nav.map(([label, href]) => <li><a href={basePath(href)}>{label}</a></li>)}
            <li>
              <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" title="Switch between light and dark mode (follows your system setting until you choose)">
                <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 14.5A9 9 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5Z" /></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
                <span class="label-dark">Dark mode</span>
                <span class="label-light">Light mode</span>
              </button>
            </li>
            <li>
              <a class="repo-link" href="https://github.com/danceratopz/retrospective-eip-complexity" target="_blank" rel="noreferrer" aria-label="View the source repository on GitHub (opens in a new tab)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C6.422 18.07 5.633 17.7 5.633 17.7c-1.087-.744.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.045.138 3.003.404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.62-5.475 5.92.435.375.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
                <span>GitHub</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer>Static and reproducible · Built from frozen research records, served without analytics or external assets · <a href="https://github.com/danceratopz/retrospective-eip-complexity">Source repository</a></footer>
    <SortableTables />
    <Tooltip />
    <script>
      const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const sync = () => button?.setAttribute('aria-pressed', String(document.documentElement.dataset.themeEffective === 'dark'));
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.themeEffective === 'dark' ? 'light' : 'dark';
        (window as any).__setTheme(next);
        sync();
      });
      document.addEventListener('themechange', sync);
      sync();
    </script>
  </body>
</html>
