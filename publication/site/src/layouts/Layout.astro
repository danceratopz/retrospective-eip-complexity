---
import '../styles/global.css';
import { basePath } from '../lib/data.js';

const { title, description = 'A reproducible evaluation of EIP complexity and observed development history.' } = Astro.props;
const nav = [
  ['Study', 'study/'],
  ['Forks', 'forks/'],
  ['EIPs', 'eips/'],
  ['Results', 'results/predicted-vs-observed/'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Retrospective LLM-Based Complexity Evaluations</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header>
      <div class="topbar">
        <a class="brand" href={basePath()}>Retrospective LLM-Based Complexity Evaluations</a>
        <nav aria-label="Primary navigation">
          <ul>{nav.map(([label, href]) => <li><a href={basePath(href)}>{label}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer>Local review preview · Static, reproducible, and served without analytics or external assets.</footer>
  </body>
</html>
