{
  "name": "retrospective-complexity-eval-publication",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "data": "uv run --project ../../research/tasks/05-retrospective-complexity-assignment --locked python ../scripts/build_records.py",
    "data:check": "uv run --project ../../research/tasks/05-retrospective-complexity-assignment --locked python ../scripts/build_records.py --check",
    "build": "npm run data && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "npm run data:check && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "uv run --project ../../research/tasks/05-retrospective-complexity-assignment --locked python ../scripts/test_publication_adapter.py && python3 ../scripts/validate_site.py",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "astro": "7.2.7",
    "typescript": "5.9.3",
    "vega": "6.4.0",
    "vega-embed": "7.1.0",
    "vega-lite": "6.4.1"
  }
}
